# Copy this file to .env.local and fill in the values to enable cloud/SaaS mode.
# Without them the app runs in local-only (localStorage) mode.
#
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only (Vercel function) environment variables -------------------
# These are read ONLY by api/provision-staff.js on the server. They must never
# be added as VITE_* vars or exposed to the browser.
#
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
