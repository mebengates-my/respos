# Copy this file to .env.local and fill in the values to enable cloud/SaaS mode.
# Without them the app runs in local-only (localStorage) mode.
#
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile public widget key. Configure the same site in the
# Cloudflare dashboard and put its SECRET below (server-only).
VITE_TURNSTILE_SITE_KEY=

# --- Server-only (Vercel function) environment variables -------------------
# These must never be added as VITE_* vars or exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated Supabase Auth email(s) allowed into the platform approval
# console. Sign in once and the API also records the account in
# public.platform_admins. Keep at least one recoverable operator account.
SUPER_ADMIN_EMAILS=creator@example.com

# Optional but recommended: a random 32+ character secret used to sign the
# short-lived proof between CAPTCHA verification and application submission.
# If omitted, the server derives this protection from the service-role key.
CAPTCHA_PROOF_SECRET=

# Mock mode only (safe/browser-visible). Defaults to admin@respos.local.
# VITE_MOCK_SUPER_ADMIN_EMAIL=admin@respos.local
